# Local-only defaults. Copy to .env; never commit .env.
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny-local-only
POSTGRES_DB=lenny
DATABASE_URL=postgresql://lenny:lenny-local-only@localhost:5432/lenny
# Native Ollama uses Metal on Apple Silicon. Compose substitutes host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=lenny-growth:8b
EMBEDDING_MODEL=nomic-embed-text
DEFAULT_LLM_PROVIDER=ollama
# Optional cloud path; no automatic fallback. Add a real key locally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AGENT_URL=http://localhost:3001
MODEL_TIMEOUT=240
RETRIEVAL_THRESHOLD=0.45
CORS_ORIGIN=http://localhost:3000
